{
  "name": "karvion-control-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KARVION CONTROL - Universal VPS Management, Automated Deployment & Hosting SaaS. Designed & Developed by Arjun Kahar.",
  "author": "Arjun Kahar",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @karvion/web dev",
    "dev:server": "pnpm --filter @karvion/control-plane dev",
    "dev:agent": "pnpm --filter @karvion/vps-agent dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @karvion/control-plane start",
    "lint": "pnpm --recursive lint",
    "test": "cd apps/control-plane && npx tsx ../../tests/run-tests.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  }
}
